<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.AcademicFrameController"
      spacing="12" style="-fx-padding:20; -fx-background-color: linear-gradient(to bottom, #e3f2fd, #bbdefb);" prefWidth="750">

    <Label text="G9 Prototype — Client"
           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill: #0d47a1;"/>

    <Button text="Load All Orders" onAction="#loadOrders"
            style="-fx-background-color:#3498db; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:5; -fx-padding: 10 30;"/>

    <TableView fx:id="tableOrders" prefHeight="240" style="-fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <columns>
            <TableColumn fx:id="colNum"      text="Order #"     prefWidth="90"/>
            <TableColumn fx:id="colDate"     text="Order Date"  prefWidth="110"/>
            <TableColumn fx:id="colVisitors" text="Visitors"    prefWidth="90"/>
            <TableColumn fx:id="colCode"     text="Conf. Code"  prefWidth="100"/>
            <TableColumn fx:id="colSub"      text="Sub. ID"     prefWidth="90"/>
            <TableColumn fx:id="colPlaced"   text="Placed Date" prefWidth="110"/>
        </columns>
    </TableView>

    <VBox spacing="10" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Update Order" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill: #0d47a1;"/>
        <GridPane hgap="10" vgap="10" style="-fx-padding:5;">
            <Label text="Order Number:"          GridPane.columnIndex="0" GridPane.rowIndex="0" style="-fx-text-fill: #1976d2; -fx-font-weight:bold;"/>
            <TextField fx:id="txtOrderNum"        GridPane.columnIndex="1" GridPane.rowIndex="0" prefWidth="200" style="-fx-background-radius: 5;"/>
            <Label text="New Date (YYYY-MM-DD):"  GridPane.columnIndex="0" GridPane.rowIndex="1" style="-fx-text-fill: #1976d2; -fx-font-weight:bold;"/>
            <TextField fx:id="txtNewDate"         GridPane.columnIndex="1" GridPane.rowIndex="1" prefWidth="200" style="-fx-background-radius: 5;"/>
            <Label text="New Visitors:"           GridPane.columnIndex="0" GridPane.rowIndex="2" style="-fx-text-fill: #1976d2; -fx-font-weight:bold;"/>
            <TextField fx:id="txtNewVisitors"     GridPane.columnIndex="1" GridPane.rowIndex="2" prefWidth="200" style="-fx-background-radius: 5;"/>
            <Button text="Update" onAction="#updateOrder"
                    GridPane.columnIndex="1" GridPane.rowIndex="3"
                    style="-fx-background-color:#e67e22; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:5; -fx-padding: 8 30;"/>
        </GridPane>
    </VBox>

    <Label fx:id="lblResult" text="" style="-fx-font-style:italic; -fx-text-fill: #27ae60; -fx-font-weight:bold;"/>

    <Button text="Exit" onAction="#getExitBtn"
            style="-fx-background-color:#e53935; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:5; -fx-padding: 10 30;"/>
</VBox>