<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.ServerPortFrameController"
      spacing="12" style="-fx-padding:20; -fx-background-color: linear-gradient(to bottom, #e8f5e9, #c8e6c9);">

    <Label text="G9 Prototype — Server"
           style="-fx-font-size:20px; -fx-font-weight:bold; -fx-text-fill: #1b5e20;"/>

    <HBox spacing="10" alignment="CENTER_LEFT" style="-fx-padding: 10; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Port:" style="-fx-font-weight:bold; -fx-text-fill: #2e7d32;"/>
        <TextField fx:id="portxt" prefWidth="100" style="-fx-background-radius: 5;"/>
        <Button text="Start Server" onAction="#Done"
                style="-fx-background-color:#27ae60; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:5; -fx-padding: 8 20;"/>
        <Button text="Exit" onAction="#getExitBtn"
                style="-fx-background-color:#e74c3c; -fx-text-fill:white; -fx-font-weight:bold; -fx-background-radius:5; -fx-padding: 8 20;"/>
    </HBox>

    <VBox spacing="8" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Connected Clients" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill: #1b5e20;"/>
        <TableView fx:id="clientTable" prefHeight="180">
            <columns>
                <TableColumn fx:id="colIP"     text="IP Address"  prefWidth="150"/>
                <TableColumn fx:id="colHost"   text="Host Name"   prefWidth="150"/>
                <TableColumn fx:id="colStatus" text="Status"      prefWidth="120"/>
            </columns>
        </TableView>
    </VBox>

    <VBox spacing="5" style="-fx-padding: 15; -fx-background-color: white; -fx-background-radius: 8; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 2);">
        <Label text="Connection Log" style="-fx-font-size:14px; -fx-font-weight:bold; -fx-text-fill: #1b5e20;"/>
        <TextArea fx:id="txtLog" prefHeight="120" editable="false"
                  style="-fx-control-inner-background: #f1f8e9; -fx-background-radius: 5; -fx-border-color: #aed581; -fx-border-radius: 5;"/>
    </VBox>
</VBox>