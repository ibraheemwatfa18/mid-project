<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.ServerPortFrameController"
      spacing="10" style="-fx-padding:15;">

    <Label text="G9 Prototype — Server"
           style="-fx-font-size:16px;-fx-font-weight:bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Port:"/>
        <TextField fx:id="portxt" prefWidth="80"/>
        <Button text="Start Server" onAction="#Done"
                style="-fx-background-color:#27ae60;-fx-text-fill:white;-fx-font-weight:bold;"/>
        <Button text="Exit" onAction="#getExitBtn"/>
    </HBox>

    <TitledPane text="Connected Client" collapsible="false">
        <GridPane hgap="10" vgap="5" style="-fx-padding:8;">
            <Label text="IP:"     GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <Label fx:id="lblIP"  GridPane.columnIndex="1" GridPane.rowIndex="0" text="—"/>
            <Label text="Host:"   GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <Label fx:id="lblHost" GridPane.columnIndex="1" GridPane.rowIndex="1" text="—"/>
            <Label text="Status:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <Label fx:id="lblStatus" GridPane.columnIndex="1" GridPane.rowIndex="2" text="—"/>
        </GridPane>
    </TitledPane>

    <Label text="Log:"/>
    <TextArea fx:id="txtLog" prefHeight="150" editable="false"/>
</VBox>