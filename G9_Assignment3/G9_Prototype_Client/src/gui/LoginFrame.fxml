<?xml version="1.0" encoding="UTF-8"?>
<?import java.net.URL?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gui.LoginController"
      styleClass="screen-bg"
      alignment="CENTER" spacing="18"
      style="-fx-padding: 50 40 40 40;"
      prefWidth="480" prefHeight="620">

    <stylesheets>
        <URL value="@gonature.css"/>
    </stylesheets>

    <!-- Logo -->
    <Label text="🌿 GoNature" styleClass="login-title"/>
    <Label text="National Park Reservation System" styleClass="login-subtitle"/>

    <!-- Login card -->
    <VBox spacing="16" styleClass="login-card" maxWidth="400">

        <Label text="Sign In" styleClass="login-card-title"/>

        <!-- Login type toggle -->
        <HBox spacing="24" alignment="CENTER_LEFT">
            <RadioButton fx:id="rbVisitor" text="Visitor / Guide"
                         selected="true" onAction="#onModeChange">
                <toggleGroup><ToggleGroup fx:id="loginMode"/></toggleGroup>
            </RadioButton>
            <RadioButton fx:id="rbStaff" text="Staff Member"
                         toggleGroup="$loginMode" onAction="#onModeChange"/>
        </HBox>

        <Separator/>

        <!-- VISITOR / GUIDE fields -->
        <VBox fx:id="visitorBox" spacing="6">
            <Label text="ID Number *" styleClass="field-label"/>
            <TextField fx:id="txtIdNumber"
                       promptText="Enter your government ID number"/>
            <Label text="Guides are recognised automatically by their registered ID."
                   styleClass="lbl-hint"/>
        </VBox>

        <!-- STAFF fields (hidden until toggle) -->
        <VBox fx:id="staffBox" spacing="6" visible="false" managed="false">
            <Label text="Username *" styleClass="field-label"/>
            <TextField fx:id="txtUsername" promptText="Enter username"/>
            <Label text="Password *" styleClass="field-label"/>
            <PasswordField fx:id="txtPassword" promptText="Enter password"/>
        </VBox>

        <!-- Error message -->
        <Label fx:id="lblError" text="" styleClass="lbl-error" wrapText="true"/>

        <!-- Login button -->
        <Button fx:id="btnLogin" text="Login" onAction="#handleLogin"
                styleClass="btn-primary" maxWidth="Infinity"/>

        <!-- Sign-up row -->
        <HBox alignment="CENTER" spacing="6">
            <Label text="New to GoNature?" styleClass="lbl-hint" style="-fx-font-style: normal;"/>
            <Button text="Create an Account" onAction="#handleSignUp" styleClass="btn-link"/>
        </HBox>

        <!-- Exit button -->
        <Button text="Exit" onAction="#handleExit"
                styleClass="btn-danger" maxWidth="Infinity"/>
    </VBox>

    <!-- Help link -->
    <Label text="Help ?" onMouseClicked="#handleHelp" styleClass="help-link"/>
</VBox>
